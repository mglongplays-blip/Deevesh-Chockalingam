# GEMINI_API_KEY: Required for Google Gemini AI calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional server-side API key for OpenRouter free models fallback.
# Obtain a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY:
# Optional Supabase PostgreSQL, Auth, and Storage credentials (free tier at https://supabase.com).
# When omitted in development, MG uses its local persistent relational store automatically.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SESSION_SECRET: Secret used to sign HTTP-only session cookies on the server.
SESSION_SECRET="change-this-to-a-long-random-string-in-production"

# ADMIN_EMAIL: Optional email granted administrator access for AI Gateway configuration.
ADMIN_EMAIL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
